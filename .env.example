# Never commit real secrets.
DATABASE_URL=
APP_URL=http://localhost:3000

# Shared platform email for all stores. Keep the real password in Hostinger only.
SMTP_HOST=smtp.hostinger.com
SMTP_USER=info@nfoodz.com
SMTP_FROM=info@nfoodz.com
SMTP_FROM_NAME=FOON
SMTP_PASSWORD=

# Cloud Edge sync is opt-in; enable only after isolated integration validation.
FOON_EDGE_PLAIN_TAKEAWAY_ENABLED=false
# Server-only random key, at least 48 bytes; never expose as NEXT_PUBLIC.
FOON_EDGE_MASTER_RECEIPT_KEY=
