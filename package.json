{
  "name": "foon-platform-v2",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.mjs",
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs",
    "notifications:worker": "node scripts/notification-worker.mjs",
    "test:migrations": "node --test scripts/sql-statements.test.mjs",
    "test:mail": "node --test scripts/mail.test.mjs",
    "mail:verify": "node scripts/verify-mail.mjs",
    "test:admin-policy": "node --test scripts/admin-policy.test.mjs",
    "test:resources": "node --test scripts/restaurant-resource-schema.test.mjs",
    "test:operations": "node --test scripts/restaurant-operations.integration.test.mjs",
    "test:browser": "playwright test scripts/merchant-dashboard.browser.test.mjs --workers=1 --reporter=line",
    "test:tax": "node --experimental-strip-types --test scripts/restaurant-tax.test.mjs scripts/restaurant-tax-boundaries.test.mjs",
    "test:activities": "node --experimental-strip-types --test scripts/activity-coverage.test.mjs scripts/activity-integration-contract.test.mjs",
    "test:payments": "node --experimental-strip-types --test scripts/payment-settings.test.mjs",
    "test:payment-webhooks": "node --experimental-strip-types --test scripts/payment-webhook.test.mjs",
    "test:media": "node --experimental-strip-types --test scripts/media-studio.test.mjs scripts/media-studio-schema.test.mjs scripts/media-oauth-state.test.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "mysql2": "^3.15.3",
    "next": "16.3.8",
    "nodemailer": "^10.0.16",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.8",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.9.0"
  }
}
