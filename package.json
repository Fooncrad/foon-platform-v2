{
  "name": "foon-platform-v2",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.mjs",
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs",
    "notifications:worker": "node scripts/notification-worker.mjs",
    "reservations:no-show-worker": "node --experimental-strip-types scripts/reservation-no-show-worker.mjs",
    "print:agent": "node --env-file=.env.print-agent scripts/foon-print-agent.mjs",
    "test:migrations": "node --test scripts/sql-statements.test.mjs scripts/marketplace-visibility-migration.test.mjs scripts/short-activity-routes.test.mjs scripts/activity-route-slug-migration.test.mjs",
    "test:mail": "node --experimental-strip-types --test scripts/mail.test.mjs scripts/notification-delivery.test.mjs scripts/customer-notification-policy.test.mjs scripts/email-verification.test.mjs",
    "mail:verify": "node scripts/verify-mail.mjs",
    "test:admin-policy": "node --test scripts/admin-policy.test.mjs",
    "test:resources": "node --experimental-strip-types --test scripts/restaurant-resource-schema.test.mjs scripts/service-order-policy.test.mjs scripts/reservation-no-show.test.mjs scripts/edge-print-agent.test.mjs scripts/foon-offline-pos.test.mjs scripts/order-role-channel-policy.test.mjs scripts/waiter-assignments.test.mjs",
    "test:print-agent": "node --test scripts/edge-print-agent.test.mjs scripts/receipt-paper.test.mjs",
    "test:operations": "node --experimental-strip-types --test scripts/restaurant-operations.integration.test.mjs",
    "test:browser": "playwright test scripts/merchant-dashboard.browser.test.mjs --workers=1 --reporter=line",
    "test:tax": "node --experimental-strip-types --test scripts/restaurant-tax.test.mjs scripts/restaurant-tax-boundaries.test.mjs",
    "test:activities": "node --experimental-strip-types --test scripts/activity-presets.test.mjs scripts/activity-tools-coverage.test.mjs scripts/activity-plan-entitlements.test.mjs scripts/catalog-copy.test.mjs scripts/customer-checkout.test.mjs scripts/african-market.test.mjs scripts/business-workspace-routing.test.mjs scripts/short-activity-routes.test.mjs scripts/activity-route-slug-migration.test.mjs",
    "test:payments": "node --experimental-strip-types --test scripts/payment-settings.test.mjs",
    "test:payment-webhooks": "node --experimental-strip-types --test scripts/payment-webhook.test.mjs",
    "test:media": "node --experimental-strip-types --test scripts/media-studio.test.mjs scripts/media-studio-schema.test.mjs scripts/media-oauth-state.test.mjs scripts/media-token-crypto.test.mjs scripts/media-account-access.test.mjs",
    "test:i18n": "node --experimental-strip-types --test scripts/ui-copy.test.mjs scripts/responsive-language-ui.test.mjs scripts/translation-leaks.test.mjs",
    "test:catalog-import": "node --experimental-strip-types --test scripts/catalog-import.test.mjs",
    "test:catalog-import:integration": "node --test scripts/catalog-import.integration.mjs",
    "test:checkout": "node --experimental-strip-types --test scripts/checkout-pricing.test.mjs",
    "test:checkout:integration": "node --test scripts/checkout-orders.integration.mjs",
    "test:offline-pos": "node --test scripts/foon-offline-pos.test.mjs",
    "test:order-roles": "node --experimental-strip-types --test scripts/order-role-channel-policy.test.mjs scripts/waiter-assignments.test.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "mysql2": "^3.15.3",
    "next": "16.3.8",
    "nodemailer": "^10.0.16",
    "qrcode": "1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.8",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.9.0"
  }
}
