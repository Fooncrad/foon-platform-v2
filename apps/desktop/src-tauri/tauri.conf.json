{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FOON Desktop",
  "version": "0.1.1",
  "identifier": "com.foon.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FOON Desktop · Station",
        "width": 1050,
        "height": 690,
        "minWidth": 360,
        "minHeight": 460,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  }
}
